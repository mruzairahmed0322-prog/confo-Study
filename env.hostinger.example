# =============================================================================
# ConfoStudy — Hostinger Production .env
# Copy to server as: confostudy/.env
# Replace DB_* and MAIL_* with your hPanel values
# =============================================================================

APP_NAME="ConfoStudy"
APP_ENV=production
APP_KEY=base64:ehvMATsSvz/zVM/1qRgdzJW/uWBhQIgM0+ZAsWNtO+8=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://admin.confostudy.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_confostudy
DB_USERNAME=u123456789_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@confostudy.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@confostudy.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=admin.confostudy.com

FORCE_HTTPS=true

# Mobile guest home = WordPress public site (HTML widgets)
WORDPRESS_HOME_URL=https://confostudy.com/
GUEST_HOME_MODE=wordpress
